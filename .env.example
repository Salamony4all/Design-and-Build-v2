# Gemini API Key (Required for Floor Plan Vision Extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional official Pascal PRO editing mode (default OFF).
# When false: no PRO button, no @pascal-app/editor dynamic bundle requested,
# STANDARD behavior unchanged. When true: a compact PRO toggle appears in the
# vertical toolbar that mounts the official @pascal-app/editor@0.9.2 shell.
NEXT_PUBLIC_PASCAL_PRO_EDITOR=false
