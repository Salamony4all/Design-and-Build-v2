// Evidence generator for the columns specialist.
//
// Produces, under packages/extraction-columns/evidence/:
//   source-audit-overlay.svg        every unclaimed vector + wall context
//   production-overlay.svg          all extractor output (accept + review)
//   accepted-overlay.svg            ACCEPT only
//   review-overlay.svg              REVIEW only
//   comparison-overlay.svg          production vs independent oracle, centroid links
//   accepted-manifest.json          full provenance for every accepted column
//   review-manifest.json            full provenance for every review column
//   mismatch-ledger.json            per-object FP / FN / duplicate accounting
//   output-hashes.json              deterministic hashes
//   performance.json                timings
//
// The oracle is read from evidence/visual-oracle.json which is generated by
// scripts/oracle.mts. Production code NEVER reads any of these files.

import { readFileSync, writeFileSync, mkdirSync } from 'fs';
import { join } from 'path';
import { createHash } from 'crypto';
import { extractColumnReport, COLUMN_DEFAULTS, type PhysicalColumn } from '../src/columns.ts';
import { loadFixture, loadUnclaimedGeometry } from '../src/fixture.ts';

// §6 test-harness fix: write to a unique per-process dir when EVIDENCE_DIR is
// set, so concurrent runs (tsc + test + smoke) never contend on the shared
// evidence/ path. Defaults to evidence/ for the canonical committed run.
const OUT = join(process.cwd(), process.env.EVIDENCE_DIR ?? 'evidence');
mkdirSync(OUT, { recursive: true });

// ---------------------------------------------------------------- run -------
const perf: Record<string, number> = {};
let t = performance.now();
const fixture = loadFixture();
perf.fixtureParseMs = round1(performance.now() - t);

t = performance.now();
const geo = loadUnclaimedGeometry();
perf.unclaimedBuildMs = round1(performance.now() - t);

t = performance.now();
const report = extractColumnReport(geo as any);
perf.extractMs = round1(performance.now() - t);

t = performance.now();
const report2 = extractColumnReport(geo as any);
perf.extractRerunMs = round1(performance.now() - t);
perf.segmentsPerSecond = Math.round((geo.segments.length / perf.extractMs) * 1000);

const accepted = report.columns.filter((c) => c.verdict === 'ACCEPT');
const review = report.columns.filter((c) => c.verdict === 'REVIEW');

function round1(v: number) { return Math.round(v * 10) / 10; }
function round6(v: number) { return Math.round(v * 1e6) / 1e6; }

// -------------------------------------------------- deterministic hashes ----
const canonicalColumn = (c: PhysicalColumn) => ({
  id: c.deterministicExtractionId,
  t: c.footprintType,
  c: [round6(c.centreProjectM.x), round6(c.centreProjectM.y)],
  w: c.widthM === undefined ? null : round6(c.widthM),
  d: c.depthM === undefined ? null : round6(c.depthM),
  r: c.radiusM === undefined ? null : round6(c.radiusM),
  rot: round6(c.rotationRad),
  v: c.verdict,
  s: c.sourceSegmentIds,
  o: c.sourceOperationIds,
});
const sha = (v: unknown) => createHash('sha256').update(JSON.stringify(v)).digest('hex');
const acceptedHash = sha(accepted.map(canonicalColumn));
const reviewHash = sha(review.map(canonicalColumn));
const allHash = sha(report.columns.map(canonicalColumn));
const acceptedHash2 = sha(report2.columns.filter((c) => c.verdict === 'ACCEPT').map(canonicalColumn));
const allHash2 = sha(report2.columns.map(canonicalColumn));

// ------------------------------------------------------------- oracle -------
interface OracleObject {
  oracleId: string;
  shapeClass: 'RECTANGLE' | 'DISC' | 'POLYGON' | 'COMPLEX';
  centreProjectM: { x: number; y: number };
  widthM: number;
  depthM: number;
  bboxOccupancy: number;
  momentIsotropy: number;
  aspect: number;
  cornerConsensus: number;
  columnLikeness: number;
}
let oracle: { objects: OracleObject[]; method: string; cellSizeMm: number } | null = null;
try {
  oracle = JSON.parse(readFileSync(join(OUT, 'visual-oracle.json'), 'utf8'));
} catch {
  console.warn('visual-oracle.json missing - run scripts/oracle.mts first');
}

// The oracle sees the *cavity* (interior) of a footprint; production reports the
// outline. A footprint therefore matches an oracle cavity when their centroids
// coincide within one raster cell diagonal and the cavity is not larger than the
// outline. Matching is geometric only: no ids, no ordering, no counts.
const CELL_M = (oracle?.cellSizeMm ?? 10) / 1000;
const MATCH_RADIUS_M = Math.max(0.08, CELL_M * 3);

interface MatchRow {
  extractionId: string;
  verdict: string;
  footprintType: string;
  centreProjectM: { x: number; y: number };
  productionWidthM: number | null;
  productionDepthM: number | null;
  oracleId: string | null;
  oracleShapeClass: string | null;
  oracleWidthM: number | null;
  oracleDepthM: number | null;
  centroidDistanceM: number | null;
  sizeDeltaM: number | null;
  status: 'MATCHED' | 'UNMATCHED_PRODUCTION';
}

const usedOracle = new Set<string>();
const matches: MatchRow[] = [];
const oracleObjects = oracle?.objects ?? [];

for (const c of report.columns) {
  let best: OracleObject | null = null;
  let bestD = Infinity;
  for (const o of oracleObjects) {
    if (usedOracle.has(o.oracleId)) continue;
    const d = Math.hypot(o.centreProjectM.x - c.centreProjectM.x, o.centreProjectM.y - c.centreProjectM.y);
    if (d < bestD) { bestD = d; best = o; }
  }
  const matched = best && bestD <= MATCH_RADIUS_M;
  if (matched && best) usedOracle.add(best.oracleId);
  const pw = c.widthM ?? (c.radiusM !== undefined ? c.radiusM * 2 : null);
  const pd = c.depthM ?? (c.radiusM !== undefined ? c.radiusM * 2 : null);
  matches.push({
    extractionId: c.deterministicExtractionId,
    verdict: c.verdict,
    footprintType: c.footprintType,
    centreProjectM: c.centreProjectM,
    productionWidthM: pw === null ? null : round6(pw),
    productionDepthM: pd === null ? null : round6(pd),
    oracleId: matched && best ? best.oracleId : null,
    oracleShapeClass: matched && best ? best.shapeClass : null,
    oracleWidthM: matched && best ? best.widthM : null,
    oracleDepthM: matched && best ? best.depthM : null,
    centroidDistanceM: matched ? round6(bestD) : null,
    sizeDeltaM: matched && best && pw !== null ? round6(Math.abs(pw - best.widthM)) : null,
    status: matched ? 'MATCHED' : 'UNMATCHED_PRODUCTION',
  });
}

// Oracle objects with strong column evidence that production never produced.
// Only compact, high-likeness RECTANGLE / DISC cavities count as a candidate
// false negative — COMPLEX/POLYGON cavities are room slivers and hatch voids.
const fnCandidates = oracleObjects.filter(
  (o) =>
    !usedOracle.has(o.oracleId) &&
    (o.shapeClass === 'RECTANGLE' || o.shapeClass === 'DISC') &&
    o.columnLikeness >= 0.85 &&
    o.aspect <= 1.6 &&
    Math.min(o.widthM, o.depthM) >= 0.25,
);

const acceptedMatched = matches.filter((m) => m.verdict === 'ACCEPT' && m.status === 'MATCHED');
const acceptedUnmatched = matches.filter((m) => m.verdict === 'ACCEPT' && m.status === 'UNMATCHED_PRODUCTION');
const precision = accepted.length ? acceptedMatched.length / accepted.length : 0;
const recall =
  acceptedMatched.length + fnCandidates.length
    ? acceptedMatched.length / (acceptedMatched.length + fnCandidates.length)
    : 0;

// duplicate detection over the final output (independent of internal collapse)
const dupPairs: Array<{ a: string; b: string; distanceM: number }> = [];
for (let i = 0; i < report.columns.length; i++) {
  for (let j = i + 1; j < report.columns.length; j++) {
    const d = Math.hypot(
      report.columns[i].centreProjectM.x - report.columns[j].centreProjectM.x,
      report.columns[i].centreProjectM.y - report.columns[j].centreProjectM.y,
    );
    if (d < 0.05) {
      dupPairs.push({
        a: report.columns[i].deterministicExtractionId,
        b: report.columns[j].deterministicExtractionId,
        distanceM: round6(d),
      });
    }
  }
}

// ------------------------------------------------------------ manifests -----
const manifestRow = (c: PhysicalColumn) => ({
  deterministicExtractionId: c.deterministicExtractionId,
  verdict: c.verdict,
  footprintType: c.footprintType,
  pascal: c.pascal,
  centreProjectM: c.centreProjectM,
  widthM: c.widthM ?? null,
  depthM: c.depthM ?? null,
  radiusM: c.radiusM ?? null,
  rotationRad: c.rotationRad,
  heightM: c.heightM,
  polygonPoints: c.polygonPoints ?? null,
  metrics: c.metrics,
  reason: c.reason,
  sourceSegmentIds: c.sourceSegmentIds,
  sourceOperationIds: c.sourceOperationIds,
});

writeFileSync(
  join(OUT, 'accepted-manifest.json'),
  JSON.stringify(
    {
      sourceHash: fixture.sourceHash,
      scaleMmPerPt: fixture.scaleMmPerPt,
      options: COLUMN_DEFAULTS,
      count: accepted.length,
      acceptedHash,
      columns: accepted.map(manifestRow),
    },
    null,
    2,
  ),
);
writeFileSync(
  join(OUT, 'review-manifest.json'),
  JSON.stringify(
    {
      sourceHash: fixture.sourceHash,
      count: review.length,
      reviewHash,
      byType: {
        CIRCULAR: review.filter((c) => c.footprintType === 'CIRCULAR').length,
        POLYGONAL: review.filter((c) => c.footprintType === 'POLYGONAL').length,
        RECTANGULAR: review.filter((c) => c.footprintType === 'RECTANGULAR').length,
      },
      columns: review.map(manifestRow),
    },
    null,
    2,
  ),
);

writeFileSync(
  join(OUT, 'mismatch-ledger.json'),
  JSON.stringify(
    {
      method: {
        oracle: oracle?.method ?? 'unavailable',
        matching: 'nearest unused oracle cavity centroid within MATCH_RADIUS_M; geometric only',
        matchRadiusM: round6(MATCH_RADIUS_M),
        note: 'The oracle measures the interior cavity of a footprint; production measures the outline. Size deltas of roughly one line weight are expected and are not mismatches.',
      },
      summary: {
        productionAccepted: accepted.length,
        productionReview: review.length,
        productionRejectedCandidates: report.rejected.length,
        oracleObjects: oracleObjects.length,
        oracleRectangleOrDisc: oracleObjects.filter((o) => o.shapeClass === 'RECTANGLE' || o.shapeClass === 'DISC').length,
        acceptedMatched: acceptedMatched.length,
        acceptedUnmatched: acceptedUnmatched.length,
        falseNegativeCandidates: fnCandidates.length,
        duplicatePairs: dupPairs.length,
        duplicatesCollapsedInternally: report.stats.duplicatesCollapsed,
        precision: round6(precision),
        recall: round6(recall),
      },
      matches,
      falseNegativeCandidates: fnCandidates,
      duplicatePairs: dupPairs,
      rejectionReasonHistogram: histogram(report.rejected.map((r) => r.reason.replace(/\([^)]*\)/g, '(..)'))),
    },
    null,
    2,
  ),
);

function histogram(items: string[]) {
  const m = new Map<string, number>();
  for (const i of items) m.set(i, (m.get(i) ?? 0) + 1);
  return Object.fromEntries([...m.entries()].sort((a, b) => b[1] - a[1]));
}

writeFileSync(
  join(OUT, 'output-hashes.json'),
  JSON.stringify(
    {
      algorithm: 'sha256 over canonicalised column records (id, type, centre, dims, rotation, verdict, source ids)',
      sourceHash: fixture.sourceHash,
      run1: { acceptedHash, reviewHash, allHash },
      run2: { acceptedHash: acceptedHash2, allHash: allHash2 },
      deterministic: acceptedHash === acceptedHash2 && allHash === allHash2,
      acceptedIds: accepted.map((c) => c.deterministicExtractionId),
      reviewIds: review.map((c) => c.deterministicExtractionId),
    },
    null,
    2,
  ),
);

writeFileSync(
  join(OUT, 'performance.json'),
  JSON.stringify(
    {
      environment: { node: process.version, platform: process.platform },
      input: {
        fixtureBytes: fixture ? undefined : undefined,
        totalFixtureLines: fixture.lines.length,
        unclaimedSegments: geo.segments.length,
        unclaimedCurves: geo.curves.length,
      },
      timingsMs: perf,
      pipelineStats: report.stats,
    },
    null,
    2,
  ),
);

// ------------------------------------------------------------- overlays -----
const wallIds = new Set(fixture.claimed.find((c) => c.kind === 'wall')?.sourceIds ?? []);
const wallLines = fixture.lines.filter((l: any) => wallIds.has(l.id));
const mm = fixture.scaleMmPerPt;
const ptToM = (v: number) => (v * mm) / 1000;

let vx0 = Infinity, vy0 = Infinity, vx1 = -Infinity, vy1 = -Infinity;
for (const l of wallLines) for (const p of [l.a, l.b]) {
  const x = ptToM(p.x), y = ptToM(p.y);
  if (x < vx0) vx0 = x; if (y < vy0) vy0 = y;
  if (x > vx1) vx1 = x; if (y > vy1) vy1 = y;
}
const M = 1.0;
vx0 -= M; vy0 -= M; vx1 += M; vy1 += M;
const VW = vx1 - vx0, VH = vy1 - vy0;
const SCALE = 60; // px per metre

function svgOpen(title: string) {
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${Math.round(VW * SCALE)}" height="${Math.round(VH * SCALE)}" viewBox="${vx0} ${vy0} ${VW} ${VH}">
<title>${title}</title>
<rect x="${vx0}" y="${vy0}" width="${VW}" height="${VH}" fill="#0f1115"/>
<g stroke-linecap="round">`;
}
const svgClose = '</g></svg>';

function wallLayer(opacity = 0.55) {
  const parts: string[] = [`<g stroke="#3d4657" stroke-width="0.045" opacity="${opacity}" fill="none">`];
  for (const l of wallLines) {
    parts.push(`<line x1="${ptToM(l.a.x).toFixed(4)}" y1="${ptToM(l.a.y).toFixed(4)}" x2="${ptToM(l.b.x).toFixed(4)}" y2="${ptToM(l.b.y).toFixed(4)}"/>`);
  }
  parts.push('</g>');
  return parts.join('');
}

function columnGlyph(c: PhysicalColumn, stroke: string, fill: string, labelText?: string) {
  const cx = c.centreProjectM.x, cy = c.centreProjectM.y;
  let body: string;
  if (c.footprintType === 'CIRCULAR' && c.radiusM) {
    body = `<circle cx="${cx.toFixed(4)}" cy="${cy.toFixed(4)}" r="${c.radiusM.toFixed(4)}" fill="${fill}" stroke="${stroke}" stroke-width="0.035"/>`;
  } else if (c.footprintType === 'POLYGONAL' && c.polygonPoints?.length) {
    const pts = c.polygonPoints.map((p) => `${p.x.toFixed(4)},${p.y.toFixed(4)}`).join(' ');
    body = `<polygon points="${pts}" fill="${fill}" stroke="${stroke}" stroke-width="0.035"/>`;
  } else {
    const w = c.widthM ?? 0.3, d = c.depthM ?? 0.3;
    const deg = (c.rotationRad * 180) / Math.PI;
    body = `<rect x="${(-w / 2).toFixed(4)}" y="${(-d / 2).toFixed(4)}" width="${w.toFixed(4)}" height="${d.toFixed(4)}" fill="${fill}" stroke="${stroke}" stroke-width="0.035" transform="translate(${cx.toFixed(4)} ${cy.toFixed(4)}) rotate(${deg.toFixed(3)})"/>`;
  }
  const lab = labelText
    ? `<text x="${(cx + 0.12).toFixed(4)}" y="${(cy - 0.12).toFixed(4)}" font-size="0.16" fill="${stroke}" font-family="monospace">${labelText}</text>`
    : '';
  return body + lab;
}

// 1. source audit overlay -----------------------------------------------------
{
  const parts = [svgOpen('CODE-06 source audit: unclaimed vectors vs claimed walls')];
  parts.push(wallLayer(0.9));
  parts.push('<g stroke="#f2c14e" stroke-width="0.012" opacity="0.5" fill="none">');
  let drawn = 0;
  for (const s of geo.segments) {
    const ax = ptToM(s.a.x), ay = ptToM(s.a.y);
    if (ax < vx0 || ax > vx1 || ay < vy0 || ay > vy1) continue;
    parts.push(`<line x1="${ax.toFixed(4)}" y1="${ay.toFixed(4)}" x2="${ptToM(s.b.x).toFixed(4)}" y2="${ptToM(s.b.y).toFixed(4)}"/>`);
    drawn++;
  }
  parts.push('</g>');
  parts.push(legend([
    ['#3d4657', `claimed wall vectors (${wallLines.length})`],
    ['#f2c14e', `unclaimed vectors inside envelope (${drawn})`],
  ]));
  parts.push(svgClose);
  writeFileSync(join(OUT, 'source-audit-overlay.svg'), parts.join('\n'));
}

// 2. production overlay -------------------------------------------------------
{
  const parts = [svgOpen('Production column extraction (accept + review)')];
  parts.push(wallLayer());
  for (const c of accepted) parts.push(columnGlyph(c, '#39d98a', 'rgba(57,217,138,0.28)'));
  for (const c of review) parts.push(columnGlyph(c, '#f2994a', 'rgba(242,153,74,0.20)'));
  parts.push(legend([
    ['#39d98a', `ACCEPT (${accepted.length})`],
    ['#f2994a', `REVIEW (${review.length})`],
  ]));
  parts.push(svgClose);
  writeFileSync(join(OUT, 'production-overlay.svg'), parts.join('\n'));
}

// 3. accepted-only overlay ----------------------------------------------------
{
  const parts = [svgOpen('Accepted columns only')];
  parts.push(wallLayer());
  accepted.forEach((c, i) => parts.push(columnGlyph(c, '#39d98a', 'rgba(57,217,138,0.32)', String(i + 1))));
  parts.push(legend([['#39d98a', `ACCEPT (${accepted.length}) - native Pascal ColumnNode drafts`]]));
  parts.push(svgClose);
  writeFileSync(join(OUT, 'accepted-overlay.svg'), parts.join('\n'));
}

// 4. review-only overlay ------------------------------------------------------
{
  const parts = [svgOpen('Review columns only')];
  parts.push(wallLayer());
  for (const c of review) {
    const stroke = c.footprintType === 'CIRCULAR' ? '#56ccf2' : c.footprintType === 'POLYGONAL' ? '#bb6bd9' : '#f2994a';
    parts.push(columnGlyph(c, stroke, 'rgba(255,255,255,0.06)'));
  }
  parts.push(legend([
    ['#56ccf2', `CIRCULAR review (${review.filter((c) => c.footprintType === 'CIRCULAR').length})`],
    ['#bb6bd9', `POLYGONAL review (${review.filter((c) => c.footprintType === 'POLYGONAL').length})`],
    ['#f2994a', `RECTANGULAR review / pilaster (${review.filter((c) => c.footprintType === 'RECTANGULAR').length})`],
  ]));
  parts.push(svgClose);
  writeFileSync(join(OUT, 'review-overlay.svg'), parts.join('\n'));
}

// 5. one-to-one comparison overlay -------------------------------------------
{
  const parts = [svgOpen('Production vs independent raster-cavity oracle (centroid linkage)')];
  parts.push(wallLayer(0.4));
  for (const o of oracleObjects) {
    const col = o.shapeClass === 'RECTANGLE' ? '#4b9fff' : o.shapeClass === 'DISC' ? '#56ccf2' : '#4a5568';
    const op = o.shapeClass === 'RECTANGLE' || o.shapeClass === 'DISC' ? 0.85 : 0.25;
    parts.push(`<rect x="${(o.centreProjectM.x - o.widthM / 2).toFixed(4)}" y="${(o.centreProjectM.y - o.depthM / 2).toFixed(4)}" width="${o.widthM.toFixed(4)}" height="${o.depthM.toFixed(4)}" fill="none" stroke="${col}" stroke-width="0.03" opacity="${op}"/>`);
  }
  for (const c of report.columns) {
    parts.push(columnGlyph(c, c.verdict === 'ACCEPT' ? '#39d98a' : '#f2994a', 'rgba(255,255,255,0.05)'));
  }
  for (const m of matches) {
    if (m.status !== 'MATCHED' || !m.oracleId) continue;
    const o = oracleObjects.find((x) => x.oracleId === m.oracleId)!;
    parts.push(`<line x1="${m.centreProjectM.x.toFixed(4)}" y1="${m.centreProjectM.y.toFixed(4)}" x2="${o.centreProjectM.x.toFixed(4)}" y2="${o.centreProjectM.y.toFixed(4)}" stroke="#ffffff" stroke-width="0.02" opacity="0.8"/>`);
  }
  for (const o of fnCandidates) {
    parts.push(`<circle cx="${o.centreProjectM.x.toFixed(4)}" cy="${o.centreProjectM.y.toFixed(4)}" r="0.35" fill="none" stroke="#eb5757" stroke-width="0.05"/>`);
  }
  parts.push(legend([
    ['#4b9fff', `oracle RECTANGLE cavity (${oracleObjects.filter((o) => o.shapeClass === 'RECTANGLE').length})`],
    ['#56ccf2', `oracle DISC cavity (${oracleObjects.filter((o) => o.shapeClass === 'DISC').length})`],
    ['#39d98a', `production ACCEPT (${accepted.length})`],
    ['#f2994a', `production REVIEW (${review.length})`],
    ['#ffffff', `1:1 centroid link (${matches.filter((m) => m.status === 'MATCHED').length})`],
    ['#eb5757', `unmatched strong oracle object / FN candidate (${fnCandidates.length})`],
  ]));
  parts.push(svgClose);
  writeFileSync(join(OUT, 'comparison-overlay.svg'), parts.join('\n'));
}

function legend(rows: Array<[string, string]>) {
  const x = vx0 + 0.3;
  let y = vy0 + 0.6;
  const parts = [`<g font-family="monospace" font-size="0.26">`];
  parts.push(`<rect x="${(x - 0.15).toFixed(3)}" y="${(y - 0.42).toFixed(3)}" width="${Math.min(VW - 0.6, 11).toFixed(3)}" height="${(rows.length * 0.42 + 0.25).toFixed(3)}" fill="rgba(0,0,0,0.65)" stroke="#2c3444" stroke-width="0.02"/>`);
  for (const [c, label] of rows) {
    parts.push(`<rect x="${x.toFixed(3)}" y="${(y - 0.2).toFixed(3)}" width="0.26" height="0.26" fill="${c}"/>`);
    parts.push(`<text x="${(x + 0.38).toFixed(3)}" y="${(y + 0.02).toFixed(3)}" fill="#d8dee9">${label}</text>`);
    y += 0.42;
  }
  parts.push('</g>');
  return parts.join('');
}

// -------------------------------------------------------------- console -----
console.log('=== COLUMNS EVIDENCE ===');
console.log('accepted', accepted.length, 'review', review.length, 'rejectedCandidates', report.rejected.length);
console.log('oracle objects', oracleObjects.length, '(rect/disc', oracleObjects.filter((o) => o.shapeClass === 'RECTANGLE' || o.shapeClass === 'DISC').length, ')');
console.log('acceptedMatched', acceptedMatched.length, 'acceptedUnmatched', acceptedUnmatched.length, 'FNcandidates', fnCandidates.length);
console.log('precision', precision.toFixed(4), 'recall', recall.toFixed(4), 'duplicatePairs', dupPairs.length);
console.log('deterministic', acceptedHash === acceptedHash2 && allHash === allHash2, acceptedHash.slice(0, 16));
console.log('perf', JSON.stringify(perf));
if (acceptedUnmatched.length) {
  console.log('unmatched accepted:');
  for (const m of acceptedUnmatched) console.log('   ', m.extractionId, m.productionWidthM, 'x', m.productionDepthM, '@', m.centreProjectM);
}
if (fnCandidates.length) {
  console.log('FN candidates:');
  for (const o of fnCandidates.slice(0, 20)) console.log('   ', o.oracleId, o.shapeClass, o.widthM, 'x', o.depthM, '@', o.centreProjectM, 'likeness', o.columnLikeness);
}
console.log('wrote 10 evidence artifacts to', OUT);
